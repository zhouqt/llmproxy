# perf.env — used by debug-env/docker-compose.perf.yaml
# RUST_LOG is warn (NOT debug) — debug-level logs dominate the latency signal
# we're trying to measure. See plans/debug-env-mock-perf.md §2.4.
# MOCK_BASE has no trailing slash — see plans/debug-env-mock-perf.md §7.2.
# Format is plain KEY=VALUE: podman compose's env_file parser (parseEnv) does
# NOT support `export` prefix or quote stripping.
LLMPROXY_API_KEY=sk-perf-local-only
MOCK_BASE=http://mock:9000
RUST_LOG=llmproxy=warn
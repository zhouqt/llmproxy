# Fallback secrets file -- template.
#
# Copy to `deploy/secrets/llmproxy.env` and fill in values ONLY while
# the TPM path is unavailable (lost vTPM state, PCR mismatch, a broken
# unseal after a firmware update). The container detects a non-empty
# file here and uses it instead of unsealing, logging a WARN on every
# start. Empty the file again (`: > deploy/secrets/llmproxy.env`) to go
# back to TPM mode.
#
# While this file is non-empty the plaintext lives on the host disk,
# so the "no plaintext outside the container" property does NOT hold.
# Treat it as a temporary bridge, not a mode to settle into.
#
# Format: `NAME=VALUE`, one per line. Parsed by llmproxy itself:
#   - `#` comment lines and blank lines are skipped
#   - an optional `export ` prefix is accepted
#   - a value wrapped in a matching pair of " or ' has them stripped
#   - no variable interpolation, no trailing-`#` comments
#     (a `#` inside a value is part of the value)
# Values are for the `${VAR}` references in config.yaml, so the names
# below are the ones config.example.yaml uses.
#
# Keep the file mode at 0600: `chmod 600 deploy/secrets/llmproxy.env`.

# Shared bearer token clients send to llmproxy.
LLMPROXY_API_KEY=

# Provider credentials. Leave a value empty to disable that provider.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
OPENCODE_API_KEY=
OPENAI_API_KEY=